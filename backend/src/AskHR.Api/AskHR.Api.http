# Use HTTPS. With the "https" launch profile, http://localhost:5062 answers 307 -> https://localhost:7124,
# and clients drop the Authorization header when they follow a redirect, so every /api call would return 401.
@AskHR.Api_HostAddress = https://localhost:7124

# Paste the token text itself (a long "eyJ..." string), not a script name or flag. Never commit a real token.
# From the main repo folder (deploy/.env lives there):  ./deploy/get-token.ps1 employee | Set-Clipboard
# Tokens expire after 5 minutes; fetch a new one when you get 401.
@token = paste-token-here

GET {{AskHR.Api_HostAddress}}/health

###

# M2: ask the local model a question (Employee or HR Admin token). The first call loads the model and is slow.
POST {{AskHR.Api_HostAddress}}/api/chat
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "question": "Can I carry over unused annual leave to next year?"
}

###

# ---------- M3: documents (HR Admin token: ./deploy/get-token.ps1 admin | Set-Clipboard) ----------

# Upload the invented sample policy. Returns 202 Accepted at once; a Hangfire job extracts and chunks it.
# @name upload
POST {{AskHR.Api_HostAddress}}/api/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=AskHrBoundary

--AskHrBoundary
Content-Disposition: form-data; name="file"; filename="lumora-leave-and-remote-work-policy.pdf"
Content-Type: application/pdf

< ../../../docs/samples/lumora-leave-and-remote-work-policy.pdf
--AskHrBoundary--

###

# Poll the uploaded document (the Location header of the 202): Processing -> Ready (or Failed + failureReason).
GET {{upload.response.headers.Location}}
Authorization: Bearer {{token}}

###

# List all documents, newest first.
GET {{AskHR.Api_HostAddress}}/api/documents
Authorization: Bearer {{token}}

###

# Delete the uploaded document; SQL Server cascades the delete to its file and chunks. 204, then 404 on a repeat.
DELETE {{AskHR.Api_HostAddress}}/api/documents/{{upload.response.body.$.id}}
Authorization: Bearer {{token}}

###
