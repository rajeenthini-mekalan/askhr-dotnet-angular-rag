# Copy to .env (same folder) and set real values. .env is git-ignored; never commit it.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, a digit and a symbol.
# Avoid $ ; ' " and ` so the password is safe in shells and connection strings.
SQL_SA_PASSWORD=ChangeMe_Str0ng!
SQL_PORT=14333

# Keycloak admin console login (http://localhost:8080)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_Adm1n!
KEYCLOAK_PORT=8080

# Demo users imported into the "askhr" realm (dev only). They fill the ${...} placeholders
# in deploy/keycloak/askhr-realm.json. Only read on the FIRST import (fresh keycloak_data volume).
ASKHR_DEMO_ADMIN_PASSWORD=ChangeMe_Demo_Adm1n!
ASKHR_DEMO_EMPLOYEE_PASSWORD=ChangeMe_Demo_Empl0yee!
