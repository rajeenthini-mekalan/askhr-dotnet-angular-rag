{
  "realm": "askhr",
  "displayName": "AskHR",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "hr-admin", "description": "Uploads and manages HR policy documents" },
      { "name": "employee", "description": "Asks policy questions and sees own chat history" }
    ]
  },
  "clients": [
    {
      "clientId": "askhr-api",
      "name": "AskHR API",
      "description": "Resource server. No login flows; exists so tokens can name it as their audience.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "askhr-web",
      "name": "AskHR web app",
      "description": "Angular SPA. Public client: authorization code flow + PKCE (S256).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "audience askhr-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "askhr-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles as flat roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "askhr-devtools",
      "name": "AskHR dev tools (DEV ONLY)",
      "description": "Dev only: password grant so curl / scripts can fetch tokens for live checks. Never enable in production.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience askhr-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "askhr-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles as flat roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@askhr.demo",
      "email": "admin@askhr.demo",
      "emailVerified": true,
      "firstName": "Hana",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${ASKHR_DEMO_ADMIN_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["default-roles-askhr", "hr-admin"]
    },
    {
      "username": "employee@askhr.demo",
      "email": "employee@askhr.demo",
      "emailVerified": true,
      "firstName": "Eli",
      "lastName": "Employee",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${ASKHR_DEMO_EMPLOYEE_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["default-roles-askhr", "employee"]
    }
  ]
}
